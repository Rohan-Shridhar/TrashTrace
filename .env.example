# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/trashtrace?retryWrites=true&w=majority

# Express server port (local dev only, optional — defaults to 3000)
PORT=3000

# Deployment URL of the frontend (used to build QR code tracking URLs)
# e.g. https://trashtrace.vercel.app
PUBLIC_URL=https://ai-trash-trace.vercel.app

# CORS — comma-separated list of allowed frontend origins (optional for strict mode)
# e.g. https://trashtrace.vercel.app,https://www.trashtrace.io
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Delivery radius in metres (optional, defaults to 500)
DELIVERY_RADIUS_METERS=500
